# Copy to .env and fill in. See README.md "Setup" for what each does.

# OpenAlex — recommended, avoids aggressive rate limiting on citation queries.
OPENALEX_API_KEY=
# Optional: email for OpenAlex's polite-pool header.
OPENALEX_MAILTO=

# Web front-end only (treexiv.web / Render deploy). Every route except
# /health requires these; unset means the web app refuses all requests.
# TREEXIV_WEB_USER=
# TREEXIV_WEB_PASSWORD=

# Optional per-run tuning overrides (defaults live in src/treexiv/config.py
# and scratch/treexiv-mvp-openalex-prd.md Section 4). Leave unset to use
# the PRD defaults.
# TREEXIV_TOTAL_CORPUS_CAP=500
# TREEXIV_FANOUT_CAP=100
# TREEXIV_BM25_TOP_K=40
# TREEXIV_SAMPLING_STRATEGY=top_cited
# TREEXIV_CACHE_DIR=.cache
