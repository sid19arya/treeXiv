# Copy to .env and fill in. See README.md "Setup" for what each does.

# OpenAlex — recommended, avoids aggressive rate limiting on citation queries.
OPENALEX_API_KEY=
# Optional: email for OpenAlex's polite-pool header.
OPENALEX_MAILTO=

# OpenRouter powers two steps: Step 0 (`treexiv identify-seed`, a web-search-
# grounded guess at which paper a description means) and the curation pass that
# decides which papers make it into the tree. Without a key, identify-seed is
# unavailable and filtering falls back to the plain BM25 top-K cut.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=z-ai/glm-5.3-flash
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# TREEXIV_LLM_WEB_SEARCH=true

# Curation tuning. TREEXIV_CURATION: auto (default) curates when a key is set
# and falls back to BM25 otherwise; llm requires curation; bm25 never calls an
# LLM. TREEXIV_CURATION_MODEL only if curation should use a different model
# than OPENROUTER_MODEL.
# TREEXIV_CURATION=auto
# TREEXIV_CURATION_MAX_NODES=35
# TREEXIV_CURATION_PREFILTER=120
# TREEXIV_CURATION_MODEL=

# Web front-end only (treexiv.web / Render deploy). Every route except
# /health requires these; unset means the web app refuses all requests.
# TREEXIV_WEB_USER=
# TREEXIV_WEB_PASSWORD=

# Optional per-run tuning overrides (defaults live in src/treexiv/config.py
# and scratch/treexiv-mvp-openalex-prd.md Section 4). Leave unset to use
# the PRD defaults.
# TREEXIV_TOTAL_CORPUS_CAP=500
# TREEXIV_FANOUT_CAP=100
# TREEXIV_BM25_TOP_K=40
# TREEXIV_SAMPLING_STRATEGY=top_cited
# TREEXIV_CACHE_DIR=.cache
